# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Production - PostgreSQL)
DB_NAME=lsoys_monitor
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_MODEL=hog

# Audio Detection
AUDIO_SILENCE_THRESHOLD=500
AUDIO_SAMPLE_RATE=44100

# Camera
DEFAULT_CAMERA_SOURCE=0
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480

# ── Attention Monitoring (v1) ──────────────────────────────────────────────
# Privacy: True = aggregate-only (class-wide % only, no per-slot cards shown).
# False = show anonymous per-slot cards. Default: True (recommended for all deployments).
ATTENTION_PRIVACY_MODE=True

# Alert: trigger notification when class attention stays below threshold for duration.
ATTENTION_ALERT_THRESHOLD=0.50        # 0.0–1.0 (50% = alert when <50% attentive)
ATTENTION_ALERT_DURATION_SECS=30      # seconds sustained below threshold before alert

# Scoring window: frames used to smooth per-slot attention (higher = less reactive flicker)
ATTENTION_ROLLING_WINDOW_FRAMES=30

# Snapshot interval: how often (seconds) to write class-wide snapshot to DB for reports
ATTENTION_SNAPSHOT_INTERVAL_SECS=5

# Head pose thresholds (degrees): faces rotated beyond these values are classified distracted.
# These are APPROXIMATIONS — adjust conservatively for your camera placement.
ATTENTION_YAW_THRESHOLD=30.0          # horizontal rotation (left/right)
ATTENTION_PITCH_THRESHOLD=25.0        # vertical rotation (up/down)
